# Copie para .env e preencha. NUNCA commite o .env real.

# Dev: SQLite local. Producao (Vercel): connection string do Postgres (Neon/Vercel Postgres).
DATABASE_URL="file:./dev.db"

NEXT_PUBLIC_SITE_NAME="The Launchpad"
# Dominio raiz SEM protocolo. Dev: localhost:3000. Producao: seudominio.com
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# RPC mainnet. ATENCAO: essa key fica PUBLICA no site — use uma key da Helius
# restrita por dominio (Allowed Domains) em producao.
NEXT_PUBLIC_RPC_URL=""

# Wallet que recebe a taxa de criacao (0.5 SOL) e as fees de partner de todos os pools
NEXT_PUBLIC_TREASURY_WALLET=""
NEXT_PUBLIC_CREATION_FEE_SOL="0.5"

# --- Metadata dos tokens no IPFS (opcional, recomendado em producao) ---
# JWT da Pinata (Server-side; na Vercel salve como Secret, SEM prefixo NEXT_PUBLIC).
# Sem ela, o proprio site serve a metadata (fallback automatico).
# PINATA_JWT=""
# Gateway dedicado da Pinata, se tiver (ex: meu-gateway.mypinata.cloud)
# PINATA_GATEWAY=""

# --- So' pros bots (rodam fora da Vercel; nunca com prefixo NEXT_PUBLIC) ---
# TREASURY_SECRET_BASE58=""
# PLATFORM_TOKEN_MINT=""
# BOT_INTERVAL_MINUTES=30
# BOT_MIN_CLAIM_SOL=0.02
# BOT_MIN_CLAIM_USDC=2
# BOT_MIN_BUYBACK_SOL=0.1
